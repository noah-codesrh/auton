# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,https://autonairh.xyz,https://www.autonairh.xyz,https://app.autonairh.xyz

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-base64-64-for-production-here
JWT_EXPIRES_IN=7d

# Privy — same app as frontend; app secret is server-only (dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Robinhood Chain / Web3 ───────────────────────────────────────────────────
# SOLANA_RPC_URL is still accepted (legacy $AUTO tooling) but payments settle on Robinhood.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# EVM treasury that receives USDG (0x…)
MASTER_VAULT_WALLET=0x0000000000000000000000000000000000000001
# After `pnpm deploy:auto`, paste the printed Robinhood contract address.
# Leave unset until $AUTO is deployed — the API still starts.
# AUTO_TOKEN_MINT=
AUTO_TOKEN_DECIMALS=6
AUTO_USD_PRICE=0.005
# Paxos USDG on Robinhood mainnet (6 decimals). Internal env name stays USDC_TOKEN_MINT.
USDC_TOKEN_MINT=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDC_TOKEN_DECIMALS=6
# Set true only for local demos without wallet USDG
MARKETPLACE_SKIP_PAYMENT=false

# ─── OpenRouter / AI Gateway ──────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# Public API origin used in provider worker scripts (production)
# PUBLIC_API_URL=https://api.autonairh.xyz
