# Site URL for Open Graph / Twitter link previews (no trailing slash)
VITE_SITE_URL=https://www.autonairobinhood.xyz

# Auton backend API (production)
VITE_AUTON_API_URL=https://api.autonairobinhood.xyz

# Privy auth — get from dashboard.privy.io
VITE_PRIVY_APP_ID=

# $AUTO on Robinhood — set after `pnpm deploy:auto` in backend
# VITE_AUTO_TOKEN_MINT=0x
# VITE_MASTER_VAULT_WALLET=0x
VITE_AUTO_TOKEN_DECIMALS=6

# Streamflow stake pool — set when live staking launches
# VITE_AUTO_STAKE_POOL=
# VITE_AUTO_REWARD_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

VITE_AUTO_TOTAL_SUPPLY=1000000000

# Robinhood Chain RPC
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
